# Copy this file to .env and fill in the values marked CHANGE_ME.
# Search
OPENSEARCH_URL=http://localhost:9200
INDEX_NAME=arxiv-chunks
SEARCH_PIPELINE=querymesh-rrf

# Jina AI embeddings (https://jina.ai/embeddings -> API key)
JINA_API_KEY=CHANGE_ME
EMBED_MODEL=jina-embeddings-v5-text-small
EMBED_DIM=1024

# vLLM on this Hyperstack VM
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=qwen3-4b

# Upstash Redis (rediss://default:TOKEN@ENDPOINT:6379)
REDIS_URL=CHANGE_ME
CACHE_TTL_SECONDS=86400

# S3 bucket for PDFs (FakeCloud first; empty = skip upload)
PAPERS_BUCKET=querymesh-papers

# Agents
AGENT_URLS=http://localhost:8101,http://localhost:8102,http://localhost:8103,http://localhost:8104,http://localhost:8105
WORKER_MODE=local

# API security
JWT_SECRET=CHANGE_ME
API_USERNAME=admin
API_PASSWORD=CHANGE_ME
API_URL=http://localhost:8090

# Observability (empty = off)
LOGFIRE_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
